  return auftraege.map(r => ({
    ...r,
    fahrzeugName: resolveDisplay(r.fields.fahrzeug, maps.fahrzeugeMap, 'kennzeichen'),
    kundeName: resolveDisplay(r.fields.kunde, maps.kundenMap, 'vorname', 'nachname'),
  }));
}

